// Prisma schema for Aurelia storefront
// Single-table design optimized for COD (cash-on-delivery) orders.
// Swap SQLite for Postgres by changing `provider` and `DATABASE_URL`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  // Human-readable order number for the customer (e.g. AUR-2026-000123)
  orderNo   String   @unique
  // The product snapshot at the time of order (so historical orders don't
  // change when the founder edits src/config/product.ts later)
  product   String
  fullName  String
  phone     String
  wilayaId  Int
  wilayaName String
  // Commune (selected from dropdown — see src/lib/communes.ts)
  communeId   Int
  communeName String
  delivery  String   @default("home") // "home" | "stop"
  quantity  Int
  unitPrice Int     // DZD per unit, server-derived
  discount  Float   @default(0) // 0 | 0.05 | 0.07 | 0.10
  deliveryFee Int   @default(100)
  total     Int     // DZD, server-derived — NEVER trust client total
  notes     String?
  status    String   @default("new") // new | called | confirmed | shipped | delivered | cancelled
  locale    String  @default("ar") // ar | fr
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([wilayaId])
}
