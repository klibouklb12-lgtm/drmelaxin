# Cloudflare Pages headers — aggressive caching + security
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML: 7-day cache + 1-day stale-while-revalidate
/
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Static assets (Next.js build output): 1 year immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images: 1 year immutable
/gallery/*
  Cache-Control: public, max-age=31536000, immutable
/logo.webp
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable

# Service Worker: never cache (must always fetch fresh)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# API: stock — CDN cache 5 min, browser 1 min (s-maxage for CDN, max-age for browser)
/api/stock
  Cache-Control: public, s-maxage=300, stale-while-revalidate=600, max-age=60

# API: order — never cache (POST requests, dynamic)
/api/order
  Cache-Control: no-store

# API: sheet (admin) — never cache
/api/sheet
  Cache-Control: no-store

# Robots: 1 day
/robots.txt
  Cache-Control: public, max-age=86400

# Security headers (applied to all routes)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
