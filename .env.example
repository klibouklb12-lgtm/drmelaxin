# ============================================================================
#  Dr.Melaxin — Environment Variables
# ============================================================================
#  Copy this file to .env (local dev) or set these in Netlify dashboard:
#  Site Settings → Environment Variables
# ============================================================================

# REQUIRED — Google Apps Script Web App URL
# Used for: order submission + stock checking + admin panel
# Setup: see download/google-apps-script.gs for setup instructions
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbyDcvKb2USPkCqZf9PqX-yxPvfo5rZ0IFGi98-syk5kU09l0q6ZazmFQ883BPoXCXiS/exec

# OPTIONAL — Server-only Google Sheet URL (hides from browser)
# If set, /api/orders uses this instead of the public URL
# GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfyc.../exec

# OPTIONAL — jsDelivr CDN for free unlimited image bandwidth
# Push repo to PUBLIC GitHub, then set to:
# https://cdn.jsdelivr.net/gh/YOUR_GITHUB_USER/YOUR_REPO@main
# Leave empty to serve images from Netlify (default)
NEXT_PUBLIC_CDN_BASE=

# OPTIONAL — Admin panel password (default: 007)
# ADMIN_PASSWORD=007

# ============================================================================
#  NOTES:
#  - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
#  - Variables without NEXT_PUBLIC_ are server-only (secret)
#  - On Netlify, set these in: Site Settings → Environment Variables
#  - After changing env vars, trigger a redeploy (they're baked at build time)
# ============================================================================
