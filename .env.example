# ============================================================================
#  Dr.Melaxin — Environment Variables (Cloudflare Pages)
# ============================================================================
#  Set these in Cloudflare Pages: Settings → Environment variables
#  https://developers.cloudflare.com/pages/configuration/environment-variables/
# ============================================================================

# REQUIRED — Google Apps Script Web App URL
# Used for: order submission + stock checking + admin panel
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbyDcvKb2USPkCqZf9PqX-yxPvfo5rZ0IFGi98-syk5kU09l0q6ZazmFQ883BPoXCXiS/exec

# REQUIRED — Node version for Cloudflare Pages build
NODE_VERSION=20

# OPTIONAL — jsDelivr CDN for image bandwidth optimization
# Even though Cloudflare Pages has unlimited bandwidth, using jsDelivr for images
# reduces Cloudflare build minutes and improves global latency.
# Repo MUST be public for jsDelivr to work.
# https://cdn.jsdelivr.net/gh/YOUR_GITHUB_USER/YOUR_REPO@main
NEXT_PUBLIC_CDN_BASE=

# ============================================================================
#  NOTES:
#  - All vars prefixed with NEXT_PUBLIC_ are visible in the browser (no secrets)
#  - There are NO server-side secrets — static export has no server
#  - Do NOT set NEXT_PUBLIC_BASE_PATH — Cloudflare Pages serves from root /
#  - After changing vars: Deployments → Retry deployment
#  - Commercial use is EXPLICITLY ALLOWED on Cloudflare Pages free tier
# ============================================================================
