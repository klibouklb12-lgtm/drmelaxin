# ============================================================================
#  Dr.Melaxin — Environment Variables (GitHub Pages / Cloudflare Pages)
# ============================================================================
#  Set these in your hosting platform's environment variables:
#  - GitHub: Settings → Secrets and variables → Actions → Variables
#  - Cloudflare Pages: Settings → Environment variables
# ============================================================================

# REQUIRED — Google Apps Script Web App URL
# Used for: order submission + stock checking + admin panel
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbyDcvKb2USPkCqZf9PqX-yxPvfo5rZ0IFGi98-syk5kU09l0q6ZazmFQ883BPoXCXiS/exec

# REQUIRED — jsDelivr CDN for free unlimited image bandwidth
# Push repo to PUBLIC GitHub, then set to:
# https://cdn.jsdelivr.net/gh/YOUR_GITHUB_USER/YOUR_REPO@main
NEXT_PUBLIC_CDN_BASE=https://cdn.jsdelivr.net/gh/YOUR_USER/drmelaxin@main

# OPTIONAL — Base path for GitHub Pages
# Set to /REPO_NAME if using username.github.io/repo-name/ URL
# Leave EMPTY if using a custom domain or Cloudflare Pages
NEXT_PUBLIC_BASE_PATH=/drmelaxin

# ============================================================================
#  NOTES:
#  - All vars prefixed with NEXT_PUBLIC_ are visible in the browser (no secrets)
#  - There are NO server-side secrets — static export has no server
#  - GitHub: set as "Variables" (not "Secrets") — they're needed at build time
#  - After changing vars, trigger a redeploy (push empty commit)
# ============================================================================
